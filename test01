local function clearConnections()
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(activeConnections)
end

local function getChar()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum and root and hum.Health > 0 then
        return char, hum, root
    end
end

local function getMoveTarget()
    local char, hum, root = getChar()
    if not char or not root then return end

    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        local mountPart = seat.AssemblyRootPart or seat
        local mountModel = seat:FindFirstAncestorOfClass("Model") or mountPart.Parent
        return mountPart, mountModel, seat
    end
    return root, char, nil
end

local function setNoclip(toggle)
    local targetPart, targetModel = getMoveTarget()
    if not targetModel then return end

    for _, v in ipairs(targetModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = not toggle
        end
    end
end

local function stopMovement()
    local targetPart = getMoveTarget()
    if targetPart and targetPart:IsA("BasePart") then
        targetPart.AssemblyLinearVelocity = Vector3.zero
        targetPart.AssemblyAngularVelocity = Vector3.zero
    end
end

local function smartWait(seconds, myId, myPriority)
    local t0 = os.clock()
    while enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) and (os.clock() - t0 < seconds) do
        while isPaused and enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) do
            task.wait(0.05)
        end
        task.wait(0.02)
    end
    return enabled and not isPaused and runId == myId and (myPriority == nil or taskPriority == myPriority)
end

local function setTargetCFrame(targetCF)
    local targetPart, targetModel = getMoveTarget()
    if not targetPart then return end

    if targetPart:IsA("BasePart") then
        targetPart.AssemblyLinearVelocity = Vector3.zero
        targetPart.AssemblyAngularVelocity = Vector3.zero
    end

    if targetModel and targetModel:IsA("Model") then
        targetModel:PivotTo(targetCF)
    else
        targetPart.CFrame = targetCF
    end
end

-- 🌊 平滑漂移移動函數 (TweenService)
local function driftTo(targetCFrame, duration, myId, myPriority)
    local targetPart, targetModel = getMoveTarget()
    if not targetPart then return false end

    setNoclip(true)
    stopMovement()

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(targetPart, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()

    local completed = false
    local conn = tween.Completed:Connect(function()
        completed = true
    end)

    while not completed and enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) do
        while isPaused do task.wait(0.05) end
        task.wait(0.02)
    end

    conn:Disconnect()
    setNoclip(false)

    if not enabled or runId ~= myId or (myPriority and taskPriority ~= myPriority) then
        tween:Cancel()
        return false
    end

    setTargetCFrame(targetCFrame)
    return true
end

-- 普通分段傳送
local function teleportTo(pos, myId, myPriority, ignoreState)
    local targetPos = pos + TP_OFFSET
    local targetPart = getMoveTarget()
    if not targetPart then return false end

    setNoclip(true)

    while (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) do
        while isPaused and (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) do
            task.wait(0.05)
        end

        targetPart = getMoveTarget()
        if not targetPart then
            setNoclip(false)
            return false
        end

        local dist = (targetPart.Position - targetPos).Magnitude
        if dist <= STEP_DIST then
            break
        end

        local dir = (targetPos - targetPart.Position).Unit
        local nextPos = targetPart.Position + dir * STEP_DIST
        setTargetCFrame(CFrame.new(nextPos))
        
        if not ignoreState then
            if not smartWait(0.05, myId, myPriority) then 
                setNoclip(false)
                return false 
            end
        else
            if myPriority and taskPriority ~= myPriority then
                setNoclip(false)
                return false
            end
            task.wait(0.05)
        end
    end

    if (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) then
        setTargetCFrame(CFrame.new(targetPos))
        setNoclip(false)
        return true
    end

    setNoclip(false)
    return false
end

local function interactPrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0)
            prompt:InputHoldEnd()
        end
    end)
end

-- 🔍 尋找最近的目標蛋
local function findNearestEgg(root)
    local folder = Workspace:FindFirstChild("RenderedEggs")
    if not folder then return end

    local best, bestDist, bestPos
    local now = os.clock()

    for _, egg in ipairs(folder:GetChildren()) do
        if targets[egg.Name] and not (blacklist[egg] and blacklist[egg] > now) then
            local ok, pivot = pcall(function() return egg:GetPivot() end)
            if ok and pivot then
                local d = (pivot.Position - root.Position).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist, bestPos = egg, d, pivot.Position
                end
            end
        end
    end
    return best, bestPos
end

