local function isGuiVisible(obj)
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("LayerCollector") and cur.Enabled == false then return false end
        cur = cur.Parent
    end
    return true
end

-- 找畫面上可見的「放下」按鈕（手上有蛋時才會出現）
local function findDropButton()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, v in ipairs(pg:GetDescendants()) do
        if (v:IsA("TextButton") or v:IsA("TextLabel"))
            and string.find(v.Text, DROP_BUTTON_TEXT, 1, true)
            and not v:IsDescendantOf(ScreenGui)
            and isGuiVisible(v) then
            local btn = v
            while btn and not btn:IsA("GuiButton") do
                btn = btn.Parent
            end
            return btn or v
        end
    end
end

-- 方法 1：直接觸發按鈕事件
local function fireSignals(obj)
    if not firesignal then return false end
    local any = false
    for _, name in ipairs({"MouseButton1Down", "MouseButton1Click", "MouseButton1Up", "Activated"}) do
        local ok = pcall(function()
            firesignal(obj[name])
        end)
        any = any or ok
    end
    return any
end

-- 方法 2、3：模擬滑鼠點擊按鈕中心
local function clickGuiObject(obj, useInset)
    local ok = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local pos = obj.AbsolutePosition + obj.AbsoluteSize / 2
        local x, y = pos.X, pos.Y
        if useInset then
            local inset = game:GetService("GuiService"):GetGuiInset()
            x, y = x + inset.X, y + inset.Y
        end
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    return ok
end

-- 放下蛋：成功的判斷是「放下按鈕消失」
local function dropEgg()
    local btn = findDropButton()
    if not btn then
        print("[重置蛋] 找不到「" .. DROP_BUTTON_TEXT .. "」按鈕（手上可能沒有蛋）")
        return false
    end
    print("[重置蛋] 找到放下按鈕：" .. btn:GetFullName())

    for method = 1, 3 do
        local tried
        if method == 1 then
            tried = fireSignals(btn)
        elseif method == 2 then
            tried = clickGuiObject(btn, true)
        else
            tried = clickGuiObject(btn, false)
        end

        if tried then
            task.wait(0.4)
            if not findDropButton() then
                print("[重置蛋] 放下成功（方法 " .. method .. "）")
                return true
            end
        end
    end

    print("[重置蛋] 三種方法都沒能放下蛋")
    return false
end

-- 收集原點附近、可以撿蛋的互動提示
local function gatherNearbyPrompts(rootPos, radius)
    local list = {}

    local function posOf(prompt)
        local par = prompt.Parent
        if par and par:IsA("BasePart") then return par.Position end
        if par and par:IsA("Attachment") then return par.WorldPosition end
    end

    local folder = Workspace:FindFirstChild("RenderedEggs")
    if folder then
        for _, e in ipairs(folder:GetChildren()) do
            if targets[e.Name] then
                for _, d in ipairs(e:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Enabled then
                        local pp = posOf(d)
                        if pp and (pp - rootPos).Magnitude <= radius then
                            table.insert(list, d)
                        end
                    end
                end
            end
        end
    end

    -- 備用：掉落的蛋不在 RenderedEggs 時，掃整個 Workspace
    if #list == 0 then
        local char = player.Character
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled and not (char and d:IsDescendantOf(char)) then
                local pp = posOf(d)
                if pp and (pp - rootPos).Magnitude <= radius then
                    table.insert(list, d)
                end
            end
        end
    end

    return list
end

-- 步行運蛋：瞬移到原點 → 放下 → 再撿起
local function resetEggAtOrigin(myId, myPriority)
    -- 目的地：和「傳送回遊戲原點」按鈕使用同一個座標
    local resetTarget = RESET_POS or getGameSpawnCFrame().Position

    -- 安全檢查：目的地下方沒有地面就不傳送，避免掉進虛空
    local ground = Workspace:Raycast(resetTarget + Vector3.new(0, 10, 0), Vector3.new(0, -300, 0))
    if not ground then
        print("[重置蛋] 目的地下方找不到地面，略過重置：" .. tostring(resetTarget))
        return false
    end

    print("[重置蛋] 步行中，瞬移到遊戲原點 " .. tostring(resetTarget))
    if not teleportTo(resetTarget, myId, myPriority, false) then return false end
    if not smartWait(RESET_SETTLE, myId, myPriority) then return false end

    if not dropEgg() then return false end
    if not smartWait(RESET_WAIT_DROP, myId, myPriority) then return false end

    local _, _, root = getChar()
    if not root then return false end
    local rootPos = root.Position

    -- 等掉落的蛋出現
    local prompts = {}
    for _ = 1, 6 do
        prompts = gatherNearbyPrompts(rootPos, RESET_PICKUP_RADIUS)
        if #prompts > 0 then break end
        if not smartWait(0.3, myId, myPriority) then return false end
    end

    if #prompts == 0 then
        print("[重置蛋] 在原點附近找不到掉落的蛋")
        return false
    end
    print("[重置蛋] 找到 " .. #prompts .. " 個可撿取的互動提示，開始重新撿起")

    -- 重新撿起：成功的判斷是「放下按鈕」再次出現
    local deadline = os.clock() + HOLD_TIMEOUT
    while os.clock() < deadline do
        for _, pr in ipairs(prompts) do
            if pr.Parent then
                interactPrompt(pr)
            end
        end
        if not smartWait(RETRY_INTERVAL, myId, myPriority) then return false end
        if findDropButton() then
            print("[重置蛋] 重新撿起成功，準備走回基地")
            return true
        end
    end

    print("[重置蛋] 重新撿起逾時")
    return false
end

-- 平滑返回原點/基地
local function returnToBase(originCFrame, myId, myPriority, isManual)
    local done = false
    local lastTime = os.clock()

    local _, humNow = getChar()
    local riding = humNow ~= nil and humNow.SeatPart ~= nil
    local returnSpeed = riding and RETURN_SPEED or RETURN_SPEED_WALK
    local holdTime = riding and HOME_HOLD or HOME_HOLD_WALK
    local flyHeight = riding and RETURN_FLY_HEIGHT_RIDE or RETURN_FLY_HEIGHT_WALK
    print("[回基地] " .. (riding and "騎乘中" or "步行中") .. "，速度 " .. returnSpeed .. "，停留 " .. holdTime .. " 秒，飛行高度 +" .. flyHeight)

    -- 路線：垂直升高 → 在高空水平飛到基地正上方 → 垂直降落到基地
    -- phase 1 = 升高，2 = 高空水平移動，3 = 降落
    local startPart = getMoveTarget()
    local startPos = startPart and startPart.Position or originCFrame.Position
    local cruiseY = math.max(startPos.Y, originCFrame.Position.Y) + flyHeight
    local phase = (flyHeight > 0) and 1 or 3

    setNoclip(true)

    -- 移動期間每個物理步驟都重新關閉碰撞
    -- （Humanoid 會自己把角色碰撞打開，只設定一次的話，速度慢時會卡在牆裡）
    local noclipConn = RunService.Stepped:Connect(function()
        setNoclip(true)
    end)
    if not isManual then
        table.insert(activeConnections, noclipConn)
    end

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if myPriority and taskPriority ~= myPriority then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        if isPaused then return end

        if not isManual and (not enabled or runId ~= myId) then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local targetPart = getMoveTarget()
        if not targetPart then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local now = os.clock()
        local dt = now - lastTime
        lastTime = now

        local pos = targetPart.Position
        local goal
        if phase == 1 then
            goal = Vector3.new(pos.X, cruiseY, pos.Z)
        elseif phase == 2 then
            goal = Vector3.new(originCFrame.Position.X, cruiseY, originCFrame.Position.Z)
        else
            goal = originCFrame.Position
        end

        local offset = goal - pos
        local dist = offset.Magnitude
        local step = returnSpeed * dt

        if dist <= step then
            if phase == 3 then
                setTargetCFrame(originCFrame)
                done = true
            else
                setTargetCFrame(CFrame.new(goal))
                phase += 1
            end
        else
            setTargetCFrame(CFrame.new(pos + offset.Unit * step))
        end
    end)

    if not isManual then
        table.insert(activeConnections, conn)
    end

    while not done do
        if myPriority and taskPriority ~= myPriority then break end
        if not isManual and (not enabled or runId ~= myId) then break end
        task.wait(0.02)
    end

    if conn and conn.Connected then
        conn:Disconnect()
    end
    if noclipConn and noclipConn.Connected then
        noclipConn:Disconnect()
    end
    setNoclip(false)

    if myPriority and taskPriority ~= myPriority then return end
    if not isManual and (not enabled or runId ~= myId) then return end

    local t0 = os.clock()
    while (isManual or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) and (os.clock() - t0 < holdTime) do
        while isPaused do task.wait(0.05) end
        setTargetCFrame(originCFrame)
        task.wait(0.02)
    end
end

-- ===== 自動巡邏/採集核心 =====
local function startLoop()
    runId += 1
    local myId = runId
    local myPriority = taskPriority

    task.spawn(function()
        local _, _, root0 = getChar()
        if root0 and not savedOriginCFrame then
            savedOriginCFrame = root0.CFrame
        end

        while enabled and runId == myId and taskPriority == myPriority do
            while isPaused and enabled and runId == myId and taskPriority == myPriority do
                task.wait(0.05)
            end

            local char, hum, root = getChar()
            if not char then
                if not smartWait(0.5, myId, myPriority) then break end
                continue
            end

            savedOriginCFrame = savedOriginCFrame or root.CFrame

            -- 1. 搜尋附近的蛋
            local egg, eggPos = findNearestEgg(root)
            if not egg then
                if not smartWait(0.3, myId, myPriority) then break end
                continue
            end

            -- 🛑 啟用防跌倒保護
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

            local currentEggName = tostring(egg.Name)
            local targetEggCF = CFrame.new(eggPos + TP_OFFSET)

            print("[EggCollector] 開始採集蛋類: " .. currentEggName)

            --------------------------------------------------------------------
            -- 🔴 分流 1：特例走 A ➔ B 路線的蛋【Volcanic Egg】
            --------------------------------------------------------------------
            if currentEggName == "Volcanic Egg" then
                print("==========================================")
                print("[Volcanic Route] 觸發 Volcanic Egg 專用 A ➔ B 路線！")
                print("==========================================")

                -- 1. 漂移至地點 A
                if not driftTo(POS_A, 2.5, myId, myPriority) then break end
                if not smartWait(0.1, myId, myPriority) then break end

                -- 2. 漂移至地點 B
                if not driftTo(POS_B, 2.0, myId, myPriority) then break end
                if not smartWait(0.1, myId, myPriority) then break end

                -- 3. 漂移前往 Volcanic Egg
                if not driftTo(targetEggCF, 1.2, myId, myPriority) then break end

                -- 4. 鎖定位置準備拿蛋
                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                -- 5. 觸發 Prompt 拿蛋
                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                -- 判斷採集結果
                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end

                -- 6. Volcanic 返程路線 (回點 B ➔ 回點 A)
                if enabled and runId == myId and taskPriority == myPriority then
                    driftTo(POS_B, 1.2, myId, myPriority)
                    smartWait(0.1, myId, myPriority)

                    driftTo(POS_A, 2.0, myId, myPriority)
                    smartWait(0.1, myId, myPriority)
                end

            --------------------------------------------------------------------
            -- 🔵 分流 2：其他所有蛋（Blackhole / Solaris / Cherub）直接傳送
            --------------------------------------------------------------------
            else
                print("[Normal Route] 執行一般蛋直接傳送: " .. currentEggName)

                -- 1. 直接傳送到蛋的位置
                if not teleportTo(eggPos, myId, myPriority, false) then break end

                -- 2. 鎖定位置準備拿蛋
                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                -- 3. 觸發 Prompt 拿蛋
                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                -- 判斷採集結果
                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)

                    -- 步行運蛋：先到原點放下再撿起，重置後再走回基地
                    local _, humW = getChar()
                    if WALK_RESET_ENABLED and humW and not humW.SeatPart then
                        resetEggAtOrigin(myId, myPriority)
                    end
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end
            end

            -- 7. 返回基地
            if enabled and runId == myId and taskPriority == myPriority and savedOriginCFrame then
                returnToBase(savedOriginCFrame, myId, myPriority, false)
            end

            if not smartWait(LOOP_DELAY, myId, myPriority) then break end
        end

        setNoclip(false)
        stopMovement()
    end)
end

