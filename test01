local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")
local VirtualUser = game:GetService("VirtualUser")

-- ⚙ 重連後要自動重新載入的腳本（留空 = 只重連，不自動載入）
-- 範例（網址載入）：
--   local AUTO_RELOAD_SOURCE = [[loadstring(game:HttpGet("https://你的網址/script.lua"))()]]
-- 範例（本機檔案）：
--   local AUTO_RELOAD_SOURCE = [[loadstring(readfile("腳本.lua"))()]]
local AUTO_RELOAD_SOURCE = ""
local REJOIN_RETRY = 5          -- 重連失敗後幾秒再試一次

-- 私人伺服器：回不去時，是否允許改進「公開伺服器」
-- false = 只嘗試回原本的私人伺服器（建議）
-- true  = 回不去就改進新的公開伺服器
local ALLOW_PUBLIC_FALLBACK = false

-- 是否在私人伺服器掛機（客戶端讀不到 PrivateServerId，所以改成手動設定）
-- true  = 私人伺服器：斷線只嘗試回原伺服器（除非 ALLOW_PUBLIC_FALLBACK = true）
-- false = 公開伺服器
local PRIVATE_SERVER_MODE = true

-- 腳本一開始就先記下伺服器編號，避免斷線後讀不到
local CACHED_JOBID = game.JobId
local CACHED_IS_PRIVATE = PRIVATE_SERVER_MODE

local antiReconnect = true
local rejoining = false
local reconnectConns = {}

local function refreshReconnectBtn()
    if antiReconnect then
        ReconnectBtn.Text = "🔁 防重連：開"
        ReconnectBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
    else
        ReconnectBtn.Text = "🔁 防重連：關"
        ReconnectBtn.BackgroundColor3 = Color3.fromRGB(70, 74, 86)
    end
end

local function queueReload()
    if AUTO_RELOAD_SOURCE == "" then return end
    local q = queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
    if not q then return end
    -- 重連後自動啟動腳本並直接開始採集
    pcall(q, "getgenv().AutoEggAutoStart = true\n" .. AUTO_RELOAD_SOURCE)
end

local function rejoin(reason)
    if not antiReconnect or rejoining then return end
    rejoining = true
    warn("[防重連] 偵測到斷線：" .. tostring(reason) .. "，準備重新連線...")

    queueReload()

    task.spawn(function()
        local attempt = 0
        while antiReconnect do
            attempt += 1
            pcall(function()
                local sameServerFirst = CACHED_IS_PRIVATE or #Players:GetPlayers() > 1
                if CACHED_IS_PRIVATE and not ALLOW_PUBLIC_FALLBACK then
                    -- 私人伺服器：只嘗試回原本的伺服器，不進公開伺服器
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, CACHED_JOBID, player)
                elseif attempt % 2 == 1 and sameServerFirst then
                    -- 優先回到同一個伺服器
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, CACHED_JOBID, player)
                else
                    -- 同伺服器失敗/只剩自己 → 進新伺服器
                    TeleportService:Teleport(game.PlaceId, player)
                end
            end)
            task.wait(REJOIN_RETRY)
        end
        rejoining = false
    end)
end

