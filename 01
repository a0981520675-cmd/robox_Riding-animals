local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local parentGui = player:FindFirstChild("PlayerGui") or CoreGui
local mainFrame = parentGui:FindFirstChild("AutoEggPathGui", true) and parentGui:FindFirstChild("AutoEggPathGui", true):FindFirstChild("MainFrame")

if mainFrame then
    -- 調整主視窗高度
    mainFrame.Size = UDim2.new(0, 220, 0, 420)

    -- 📍 點 A 座標
    local POS_A = CFrame.new(-4888.9, 41278.3, -3735.4)[cite: 1]
    -- 📍 點 B 座標
    local POS_B = CFrame.new(-4972.4, 41285.8, -3645.5)[cite: 1]

    -- 建立點 A 按鈕
    local TpABtn = Instance.new("TextButton")
    TpABtn.Name = "TpABtn"
    TpABtn.Size = UDim2.new(1, -20, 0, 36)
    TpABtn.Position = UDim2.new(0, 10, 0, 168)
    TpABtn.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
    TpABtn.Text = "📍 傳送至點 A"
    TpABtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TpABtn.TextSize = 13
    TpABtn.Font = Enum.Font.GothamBold
    TpABtn.Parent = mainFrame

    local TpACorner = Instance.new("UICorner")
    TpACorner.CornerRadius = UDim.new(0, 6)
    TpACorner.Parent = TpABtn

    -- 建立點 B 按鈕
    local TpBBtn = Instance.new("TextButton")
    TpBBtn.Name = "TpBBtn"
    TpBBtn.Size = UDim2.new(1, -20, 0, 36)
    TpBBtn.Position = UDim2.new(0, 10, 0, 208)
    TpBBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 200)
    TpBBtn.Text = "📍 傳送至點 B"
    TpBBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TpBBtn.TextSize = 13
    TpBBtn.Font = Enum.Font.GothamBold
    TpBBtn.Parent = mainFrame

    local TpBCorner = Instance.new("UICorner")
    TpBCorner.CornerRadius = UDim.new(0, 6)
    TpBCorner.Parent = TpBBtn

    -- 按鈕點擊事件（直接呼叫主腳本的函數或角色傳送）
    TpABtn.MouseButton1Click:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = POS_A + Vector3.new(0, 4, 0)
        end
    end)

    TpBBtn.MouseButton1Click:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = POS_B + Vector3.new(0, 4, 0)
        end
    end)

    print("[Success] A、B 傳送點按鈕已成功掛載到介面上！")
else
    print("[Error] 找不到 AutoEggPathGui 介面，請先啟動主腳本！")
end
