local function clearConnections()
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(activeConnections)
end

local function getChar()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum and root and hum.Health > 0 then
        return char, hum, root
    end
end

local function getMoveTarget()
    local char, hum, root = getChar()
    if not char or not root then return end

    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        local mountPart = seat.AssemblyRootPart or seat
        local mountModel = seat:FindFirstAncestorOfClass("Model") or mountPart.Parent
        return mountPart, mountModel, seat
    end
    return root, char, nil
end

local function setNoclip(toggle)
    local targetPart, targetModel = getMoveTarget()
    if not targetModel then return end

    for _, v in ipairs(targetModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = not toggle
        end
    end
end

local function stopMovement()
    local targetPart = getMoveTarget()
    if targetPart and targetPart:IsA("BasePart") then
        targetPart.AssemblyLinearVelocity = Vector3.zero
        targetPart.AssemblyAngularVelocity = Vector3.zero
    end
end

local function smartWait(seconds, myId, myPriority)
    local t0 = os.clock()
    while enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) and (os.clock() - t0 < seconds) do
        while isPaused and enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) do
            task.wait(0.05)
        end
        task.wait(0.01)
    end
    return enabled and not isPaused and runId == myId and (myPriority == nil or taskPriority == myPriority)
end

local function setTargetCFrame(targetCF)
    local targetPart, targetModel = getMoveTarget()
    if not targetPart then return end

    if targetPart:IsA("BasePart") then
        targetPart.AssemblyLinearVelocity = Vector3.zero
        targetPart.AssemblyAngularVelocity = Vector3.zero
    end

    if targetModel and targetModel:IsA("Model") then
        targetModel:PivotTo(targetCF)
    else
        targetPart.CFrame = targetCF
    end
end

-- 🌊 平滑漂移移動函數 (高速 Tween)
local function driftTo(targetCFrame, duration, myId, myPriority)
    local targetPart, targetModel = getMoveTarget()
    if not targetPart then return false end

    setNoclip(true)
    stopMovement()

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(targetPart, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()

    local completed = false
    local conn = tween.Completed:Connect(function()
        completed = true
    end)

    while not completed and enabled and runId == myId and (myPriority == nil or taskPriority == myPriority) do
        while isPaused do task.wait(0.05) end
        task.wait(0.01)
    end

    conn:Disconnect()
    setNoclip(false)

    if not enabled or runId ~= myId or (myPriority and taskPriority ~= myPriority) then
        tween:Cancel()
        return false
    end

    setTargetCFrame(targetCFrame)
    return true
end

-- 高速分段傳送
local function teleportTo(pos, myId, myPriority, ignoreState)
    local targetPos = pos + TP_OFFSET
    local targetPart = getMoveTarget()
    if not targetPart then return false end

    setNoclip(true)

    while (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) do
        while isPaused and (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) do
            task.wait(0.05)
        end

        targetPart = getMoveTarget()
        if not targetPart then
            setNoclip(false)
            return false
        end

        local dist = (targetPart.Position - targetPos).Magnitude
        if dist <= STEP_DIST then
            break
        end

        local dir = (targetPos - targetPart.Position).Unit
        local nextPos = targetPart.Position + dir * STEP_DIST
        setTargetCFrame(CFrame.new(nextPos))
        
        if not ignoreState then
            if not smartWait(0.02, myId, myPriority) then 
                setNoclip(false)
                return false 
            end
        else
            if myPriority and taskPriority ~= myPriority then
                setNoclip(false)
                return false
            end
            task.wait(0.02)
        end
    end

    if (ignoreState or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) then
        setTargetCFrame(CFrame.new(targetPos))
        setNoclip(false)
        return true
    end

    setNoclip(false)
    return false
end

local function interactPrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0)
            prompt:InputHoldEnd()
        end
    end)
end

-- 🔍 動態偵測並點擊「放下」按鈕
local function clickDynamicDropButton()
    pcall(function()
        local playerGui = player:FindFirstChild("PlayerGui")
        if not playerGui then return end

        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextButton") and (gui.Text == "放下" or string.find(gui.Text, "放")) and gui.Visible then
                local pos = gui.AbsolutePosition + (gui.AbsoluteSize / 2)
                VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                task.wait(0.08)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                print("[AutoDrop] 動態偵測並成功點擊「放下」按鈕！")
            end
        end
    end)
end

-- 🔍 尋找最近的目標蛋
local function findNearestEgg(root)
    local folder = Workspace:FindFirstChild("RenderedEggs")
    if not folder then return end

    local best, bestDist, bestPos
    local now = os.clock()

    for _, egg in ipairs(folder:GetChildren()) do
        if targets[egg.Name] and not (blacklist[egg] and blacklist[egg] > now) then
            local ok, pivot = pcall(function() return egg:GetPivot() end)
            if ok and pivot then
                local d = (pivot.Position - root.Position).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist, bestPos = egg, d, pivot.Position
                end
            end
        end
    end
    return best, bestPos
end

-- 高速返回基地 (SPEED = 280)
local function returnToBase(originCFrame, myId, myPriority, isManual)
    local done = false
    local lastTime = os.clock()

    setNoclip(true)

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if myPriority and taskPriority ~= myPriority then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        if isPaused then return end

        if not isManual and (not enabled or runId ~= myId) then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local targetPart = getMoveTarget()
        if not targetPart then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local now = os.clock()
        local dt = now - lastTime
        lastTime = now

        local offset = originCFrame.Position - targetPart.Position
        local dist = offset.Magnitude
        local step = RETURN_SPEED * dt

        if dist <= step then
            setTargetCFrame(originCFrame)
            done = true
        else
            setTargetCFrame(CFrame.new(targetPart.Position + offset.Unit * step))
        end
    end)

    if not isManual then
        table.insert(activeConnections, conn)
    end

    while not done do
        if myPriority and taskPriority ~= myPriority then break end
        if not isManual and (not enabled or runId ~= myId) then break end
        task.wait(0.01)
    end

    if conn and conn.Connected then
        conn:Disconnect()
    end
    setNoclip(false)

    if myPriority and taskPriority ~= myPriority then return end
    if not isManual and (not enabled or runId ~= myId) then return end

    local t0 = os.clock()
    while (isManual or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) and (os.clock() - t0 < HOME_HOLD) do
        while isPaused do task.wait(0.05) end
        setTargetCFrame(originCFrame)
        -- 🎯 到基地後持續連點「放下」按鈕
        clickDynamicDropButton()
        task.wait(0.15)
    end
end

-- ===== 自動巡邏/採集核心 =====
local function startLoop()
    runId += 1
    local myId = runId
    local myPriority = taskPriority

    task.spawn(function()
        -- 🎯 啟動時自動抓取當前站立位置作為基地
        local _, _, root0 = getChar()
        if root0 and not dynamicBaseCFrame then
            dynamicBaseCFrame = root0.CFrame
            print("[AutoBase] 已自動記錄當前位置為基地座標！")
        end

        while enabled and runId == myId and taskPriority == myPriority do
            while isPaused and enabled and runId == myId and taskPriority == myPriority do
                task.wait(0.05)
            end

            local char, hum, root = getChar()
            if not char then
                if not smartWait(0.3, myId, myPriority) then break end
                continue
            end

            dynamicBaseCFrame = dynamicBaseCFrame or root.CFrame

            -- 1. 搜尋附近的蛋
            local egg, eggPos = findNearestEgg(root)
            if not egg then
                if not smartWait(0.2, myId, myPriority) then break end
                continue
            end

            -- 🛑 啟用防跌倒保護
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

            local currentEggName = tostring(egg.Name)
            local targetEggCF = CFrame.new(eggPos + TP_OFFSET)

            print("[EggCollector] 高速採集蛋類: " .. currentEggName)

            --------------------------------------------------------------------
            -- 🔴 分流 1：Volcanic Egg 走專屬 A ➔ B 高速路線
            --------------------------------------------------------------------
            if currentEggName == "VolcanicEgg" then
                print("[Volcanic Route] 觸發 Volcanic Egg 專用 A ➔ B 極速路線！")

                if not driftTo(POS_A, 0.6, myId, myPriority) then break end
                if not driftTo(POS_B, 0.4, myId, myPriority) then break end
                if not driftTo(targetEggCF, 0.3, myId, myPriority) then break end

                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end

                if enabled and runId == myId and taskPriority == myPriority then
                    driftTo(POS_B, 0.3, myId, myPriority)
                    driftTo(POS_A, 0.5, myId, myPriority)
                end

            --------------------------------------------------------------------
            -- 🔵 分流 2：其他所有蛋（Blackhole / Solaris / Cherub）直接高速傳送
            --------------------------------------------------------------------
            else
                print("[Normal Route] 執行一般蛋極速傳送: " .. currentEggName)

                if not teleportTo(eggPos, myId, myPriority, false) then break end

                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end
            end

            --------------------------------------------------------------------
            -- 🌀 拿完蛋後 ➔ 直接高速飄回動態基地並放下
            --------------------------------------------------------------------
            if enabled and runId == myId and taskPriority == myPriority then
                if dynamicBaseCFrame then
                    print("[ReturnHome] 高速飄回基地並放下蛋...")
                    returnToBase(dynamicBaseCFrame, myId, myPriority, false)
                end
            end

            if not smartWait(LOOP_DELAY, myId, myPriority) then break end
        end

        setNoclip(false)
        stopMovement()
    end)
end

-- ===== UI 狀態刷新控制 =====

local function stopLogic()
    enabled = false
    isPaused = false
    runId += 1
    taskPriority += 1
    clearConnections()
    setNoclip(false)
    stopMovement()
    resetBtnStyles()

    StartStopBtn.Text = "▶ 啟動腳本"
    StartStopBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)

    PauseBtn.Text = "⏸ 暫停"
    PauseBtn.BackgroundColor3 = Color3.fromRGB(55, 58, 68)
    PauseBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
end

local function startLogic()
    stopLogic()
    enabled = true
    isPaused = false

    StartStopBtn.Text = "⏹ 停止腳本"
    StartStopBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)

    PauseBtn.Text = "⏸ 暫停"
    PauseBtn.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
    PauseBtn.TextColor3 = Color3.fromRGB(220, 220, 220)

    startLoop()
end

-- ===== 按鈕事件綁定 =====

StartStopBtn.MouseButton1Click:Connect(function()
    if enabled then stopLogic() else startLogic() end
end)

PauseBtn.MouseButton1Click:Connect(function()
    if not enabled then return end
    isPaused = not isPaused
    if isPaused then
        PauseBtn.Text = "▶ 繼續"
        PauseBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 40)
        PauseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        PauseBtn.Text = "⏸ 暫停"
        PauseBtn.BackgroundColor3 = Color3.fromRGB(45, 48, 56)
        PauseBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

