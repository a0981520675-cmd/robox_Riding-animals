-- ===== 遊戲預設出生點 (世界原點 / 中心點) =====
local DEFAULT_SPAWN_POS = Vector3.new(0, 50, 0)

local function getGameSpawnCFrame()
    local spawnObj = Workspace:FindFirstChildOfClass("SpawnLocation") 
        or Workspace:FindFirstChild("SpawnLocation", true)
        or Workspace:FindFirstChild("Spawn", true)
    
    if spawnObj and spawnObj:IsA("BasePart") then
        return spawnObj.CFrame + Vector3.new(0, 4, 0)
    end
    return CFrame.new(DEFAULT_SPAWN_POS)
end

