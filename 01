local function getGameSpawnCFrame()
    local spawnObj = Workspace:FindFirstChildOfClass("SpawnLocation") 
        or Workspace:FindFirstChild("SpawnLocation", true)
        or Workspace:FindFirstChild("Spawn", true)
    
