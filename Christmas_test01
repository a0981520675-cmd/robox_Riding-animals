local function getCandyCount()
    local sd = player:FindFirstChild("SavedData")
    local v = sd and sd:FindFirstChild("HalloweenCandy")
    return v and v.Value
end

-- 這個生成點「現在有糖果」嗎？
-- 依據紀錄：糖果出現時 CandyAmount 的 ForceDisabled 會變 false（離多遠都看得到），
-- 而 Pickup 的 CandyPromptAvailable 要再等約 2 秒、而且似乎要靠近才會變 true。
-- 所以兩個條件只要有一個成立，就當作有糖果。
local function candyIsPresent(prompt)
    if prompt:GetAttribute("CandyPromptAvailable") == true then return true end
    local amount = prompt.Parent and prompt.Parent:FindFirstChild("CandyAmount")
    return amount ~= nil and amount:GetAttribute("ForceDisabled") == false
end

-- 糖果被撿走了嗎？（屬性明確變成「沒有」）
local function candyIsGone(prompt)
    if prompt:GetAttribute("CandyPromptAvailable") == false then return true end
    local amount = prompt.Parent and prompt.Parent:FindFirstChild("CandyAmount")
    return amount ~= nil and amount:GetAttribute("ForceDisabled") == true
end

-- 找最近、而且種類符合 CANDY_TYPES 的糖果生成點
local function findNearestCandy(root)
    local area = Workspace:FindFirstChild("HalloweenArea")
    local spawns = area and area:FindFirstChild("CandySpawns")
    if not spawns then return end

    local best, bestDist, bestPos
    local now = os.clock()

    for _, d in ipairs(spawns:GetDescendants()) do
        if d:IsA("ProximityPrompt") and CANDY_TYPES[d.ObjectText]
            and (not CANDY_REQUIRE_AVAILABLE or candyIsPresent(d))
            and not (blacklist[d] and blacklist[d] > now) then
            local par = d.Parent
            if par and par:IsA("BasePart") then
                local dist = (par.Position - root.Position).Magnitude
                if not bestDist or dist < bestDist then
                    best, bestDist, bestPos = d, dist, par.Position
                end
            end
        end
    end

    if best then
        return best, bestPos, best.ObjectText
    end
end

-- 找不到糖果時，說明目前的狀況（區域在不在、有幾個提示、屬性是不是 true）
local function candyDiagnose()
    local area = Workspace:FindFirstChild("HalloweenArea")
    if not area then
        return "找不到 Workspace.HalloweenArea（可能不在活動區域，或活動的結構被改了）"
    end
    local spawns = area:FindFirstChild("CandySpawns")
    if not spawns then
        return "找不到 HalloweenArea.CandySpawns（結構可能被改了）"
    end

    local total, typeOk, avail, present = 0, 0, 0, 0
    local others, otherNames = {}, {}
    for _, d in ipairs(spawns:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            total = total + 1
            if CANDY_TYPES[d.ObjectText] then
                typeOk = typeOk + 1
            else
                local t = tostring(d.ObjectText)
                if not others[t] then
                    others[t] = true
                    table.insert(otherNames, t)
                end
            end
            if d:GetAttribute("CandyPromptAvailable") == true then
                avail = avail + 1
            end
            if candyIsPresent(d) then
                present = present + 1
            end
        end
    end

    local otherText = "無"
    if #otherNames > 0 then
        otherText = table.concat(otherNames, "、")
    end
    return string.format("生成點提示共 %d 個｜種類符合 %d 個｜CandyPromptAvailable=true 共 %d 個｜判定有糖果 共 %d 個｜不在 CANDY_TYPES 的物品文字：%s",
        total, typeOk, avail, present, otherText)
end

-- 平滑返回原點/基地
local function returnToBase(originCFrame, myId, myPriority, isManual)
    local done = false
    local lastTime = os.clock()

    setNoclip(true)

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if myPriority and taskPriority ~= myPriority then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        if isPaused then return end

        if not isManual and (not enabled or runId ~= myId) then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local targetPart = getMoveTarget()
        if not targetPart then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local now = os.clock()
        local dt = now - lastTime
        lastTime = now

        local offset = originCFrame.Position - targetPart.Position
        local dist = offset.Magnitude
        local step = RETURN_SPEED * dt

        if dist <= step then
            setTargetCFrame(originCFrame)
            done = true
        else
            setTargetCFrame(CFrame.new(targetPart.Position + offset.Unit * step))
        end
    end)

    if not isManual then
        table.insert(activeConnections, conn)
    end

    while not done do
        if myPriority and taskPriority ~= myPriority then break end
        if not isManual and (not enabled or runId ~= myId) then break end
        task.wait(0.02)
    end

    if conn and conn.Connected then
        conn:Disconnect()
    end
    setNoclip(false)

    if myPriority and taskPriority ~= myPriority then return end
    if not isManual and (not enabled or runId ~= myId) then return end

    local t0 = os.clock()
    while (isManual or (enabled and runId == myId)) and (myPriority == nil or taskPriority == myPriority) and (os.clock() - t0 < HOME_HOLD) do
        while isPaused do task.wait(0.05) end
        setTargetCFrame(originCFrame)
        task.wait(0.02)
    end
end

-- ===== 自動巡邏/採集核心 =====
local function startLoop()
    runId += 1
    local myId = runId
    local myPriority = taskPriority

    task.spawn(function()
        local _, _, root0 = getChar()
        if root0 and not savedOriginCFrame then
            savedOriginCFrame = root0.CFrame
        end

        while enabled and runId == myId and taskPriority == myPriority do
            while isPaused and enabled and runId == myId and taskPriority == myPriority do
                task.wait(0.05)
            end

            local char, hum, root = getChar()
            if not char then
                if not smartWait(0.5, myId, myPriority) then break end
                continue
            end

            savedOriginCFrame = savedOriginCFrame or root.CFrame

            -- 🍬 糖果模式：撿糖果 → 回交付位置（蛋的流程與舊基地不受影響）
            if candyMode then
                local prompt, candyPos, candyType = findNearestCandy(root)
                if not prompt then
                    if os.clock() - candyIdleLog > 10 then
                        candyIdleLog = os.clock()
                        print("[糖果] 目前附近沒有可撿的糖果，等待中... | " .. candyDiagnose())
                    end
                    if not smartWait(1, myId, myPriority) then break end
                    continue
                end

                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

                local slotName = prompt.Parent and prompt.Parent.Name or "?"
                print("[糖果] 前往 " .. tostring(candyType) .. "（" .. slotName .. "）")
                if not teleportTo(candyPos, myId, myPriority, false) then break end

                local candyCF = CFrame.new(candyPos + TP_OFFSET)
                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(candyCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                -- 提示要靠近才會啟用：等它啟用後觸發；撿取成功的判斷：數量增加，或提示由啟用變回關閉
                local before = getCandyCount()
                local picked = false
                local sawEnabled = false
                local tC = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and (os.clock() - tC < CANDY_WAIT_ENABLE) do
                    while isPaused do task.wait(0.05) end

                    if not prompt.Parent then
                        picked = true
                        break
                    end

                    if sawEnabled and candyIsGone(prompt) then
                        picked = true
                        break
                    end

                    if prompt.Enabled then
                        sawEnabled = true
                        interactPrompt(prompt)
                    elseif sawEnabled then
                        picked = true
                        break
                    end

                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end

                    local nowCount = getCandyCount()
                    if before and nowCount and nowCount > before then
                        picked = true
                        break
                    end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                if picked then
                    print("[糖果] 撿取成功：" .. tostring(candyType) .. "，糖果數量 = " .. tostring(getCandyCount()))
                    candyPickedCount += 1
                    smartWait(PICKUP_WAIT, myId, myPriority)

                    if candyPickedCount >= CANDY_DELIVER_EVERY then
                        candyPickedCount = 0
                        if enabled and runId == myId and taskPriority == myPriority then
                            returnToBase(CANDY_DELIVERY_CF, myId, myPriority, false)
                        end
                    end
                else
                    print("[糖果] " .. slotName .. " 目前沒有糖果（提示一直沒啟用），先跳過")
                    blacklist[prompt] = os.clock() + CANDY_BLACKLIST_TIME
                end

                if not smartWait(LOOP_DELAY, myId, myPriority) then break end
                continue
            end

            -- 1. 搜尋附近的蛋
            local egg, eggPos = findNearestEgg(root)
            if not egg then
                if not smartWait(0.3, myId, myPriority) then break end
                continue
            end

            -- 🛑 啟用防跌倒保護
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

            local currentEggName = tostring(egg.Name)
            local targetEggCF = CFrame.new(eggPos + TP_OFFSET)

            print("[EggCollector] 開始採集蛋類: " .. currentEggName)

            --------------------------------------------------------------------
            -- 🔴 分流 1：特例走 A ➔ B 路線的蛋【Volcanic Egg】
            --------------------------------------------------------------------
            if currentEggName == "Volcanic Egg" then
                print("==========================================")
                print("[Volcanic Route] 觸發 Volcanic Egg 專用 A ➔ B 路線！")
                print("==========================================")

                -- 1. 漂移至地點 A
                if not driftTo(POS_A, 2.5, myId, myPriority) then break end
                if not smartWait(0.1, myId, myPriority) then break end

                -- 2. 漂移至地點 B
                if not driftTo(POS_B, 2.0, myId, myPriority) then break end
                if not smartWait(0.1, myId, myPriority) then break end

                -- 3. 漂移前往 Volcanic Egg
                if not driftTo(targetEggCF, 1.2, myId, myPriority) then break end

                -- 4. 鎖定位置準備拿蛋
                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                -- 5. 觸發 Prompt 拿蛋
                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                -- 判斷採集結果
                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end

                -- 6. Volcanic 返程路線 (回點 B ➔ 回點 A)
                if enabled and runId == myId and taskPriority == myPriority then
                    driftTo(POS_B, 1.2, myId, myPriority)
                    smartWait(0.1, myId, myPriority)

                    driftTo(POS_A, 2.0, myId, myPriority)
                    smartWait(0.1, myId, myPriority)
                end

            --------------------------------------------------------------------
            -- 🔵 分流 2：其他所有蛋（Blackhole / Solaris / Cherub）直接傳送
            --------------------------------------------------------------------
            else
                print("[Normal Route] 執行一般蛋直接傳送: " .. currentEggName)

                -- 1. 直接傳送到蛋的位置
                if not teleportTo(eggPos, myId, myPriority, false) then break end

                -- 2. 鎖定位置準備拿蛋
                local lockConn = RunService.Heartbeat:Connect(function()
                    if enabled and not isPaused and runId == myId and taskPriority == myPriority then
                        setTargetCFrame(targetEggCF)
                    end
                end)
                table.insert(activeConnections, lockConn)

                smartWait(SYNC_WAIT, myId, myPriority)

                -- 3. 觸發 Prompt 拿蛋
                local t0 = os.clock()
                while enabled and runId == myId and taskPriority == myPriority and egg.Parent and (os.clock() - t0 < HOLD_TIMEOUT) do
                    while isPaused do task.wait(0.05) end
                    for _, v in ipairs(egg:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            interactPrompt(v)
                        end
                    end
                    if not smartWait(RETRY_INTERVAL, myId, myPriority) then break end
                end

                if lockConn and lockConn.Connected then lockConn:Disconnect() end

                -- 判斷採集結果
                if not egg.Parent then
                    smartWait(PICKUP_WAIT, myId, myPriority)
                else
                    blacklist[egg] = os.clock() + BLACKLIST_TIME
                end
            end

            -- 7. 返回基地
            if enabled and runId == myId and taskPriority == myPriority and savedOriginCFrame then
                returnToBase(savedOriginCFrame, myId, myPriority, false)
            end

            if not smartWait(LOOP_DELAY, myId, myPriority) then break end
        end

        setNoclip(false)
        stopMovement()
    end)
end

